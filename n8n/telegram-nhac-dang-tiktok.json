      "name": "Soạn tin",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        1320,
        300
      ],
      "parameters": {
        "jsCode": "const r = $('Lấy 1 video').first().json;\nconst cfg = $('Cấu hình Telegram').first().json;\nconst esc = (s) => String(s ?? '').replace(/&/g, '&amp;').replace(/</g, '&lt;').replace(/>/g, '&gt;');\nconst sec = Math.round(Number(r.duration_sec) || 0);\nconst part = r.part ? ` · Phần ${r.part}/${r.total_parts}` : ' · Trọn bộ';\nconst lines = [\n  `🎬 <b>${esc(r.title)}</b>${part}`,\n  `⏱ ${Math.floor(sec / 60)}:${String(sec % 60).padStart(2, '0')}`,\n  '',\n  '📝 <b>Caption</b> (chạm vào khung để copy):',\n  `<pre>${esc(String(r.post_description ?? '').slice(0, 3500))}</pre>`,\n  '',\n  `📥 <a href=\"${esc(r.video_url)}\">Tải video từ Drive</a>`,\n];\nif (r.cover_url) lines.push(`🖼 <a href=\"${esc(r.cover_url)}\">Ảnh bìa</a>`);\nreturn [{ json: { id: r.id, payload: {\n  chat_id: cfg.chat_id, parse_mode: 'HTML', text: lines.join('\n'), link_preview_options: { is_disabled: true },\n  reply_markup: { inline_keyboard: [[\n    { text: '✅ Đã đăng', callback_data: `posted|${r.id}` },\n    { text: '⏭ Bỏ qua', callback_data: `skip|${r.id}` },\n  ]] },\n} } }];"
      }
    },
    {
      "id": "557a3996-1a10-4d11-864a-b77c69b01c1b",
      "name": "Gửi Telegram",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
