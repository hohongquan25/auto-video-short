    {
      "id": "66b84d0f-7073-4121-9a30-26fe4447af5f",
      "name": "Tin các ngày trước",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        660,
        300
      ],
      "parameters": {
        "jsCode": "// Tin của các ngày trước nằm liền nhau ở đầu tab (ghi theo thứ tự thời gian).\nconst today = $now.toISODate();\nconst rows = $input.all().map((i) => i.json);\nlet prefix = 0;\nwhile (prefix < rows.length && String(rows[prefix].date) !== today) prefix++;\nreturn rows.slice(0, prefix).map((r) => ({ json: { message_id: Number(r.message_id), prefix } }));"
      }
    },
    {
      "id": "cf207b3b-6f12-4867-a3c7-23f9861024b4",
      "name": "Xoá tin",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        880,
        300
      ],
      "onError": "continueRegularOutput",
      "parameters": {
        "method": "POST",
        "url": "=https://api.telegram.org/bot{{ $('Cấu hình Telegram').first().json.bot_token }}/deleteMessage",
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={{ JSON.stringify({ chat_id: $('Cấu hình Telegram').first().json.chat_id, message_id: $json.message_id }) }}",
        "options": {}
      }
    },
    {
      "id": "7a8a55d1-a8f7-415b-a7ca-d6017c497c7b",
      "name": "Xoá dòng nhật ký",
      "type": "n8n-nodes-base.googleSheets",
