        "documentId": {
          "__rl": true,
          "value": "https://docs.google.com/spreadsheets/d/1pMzhPKYOwWvMFCQJHxgJFCKnDepOzyMQeZ_qsiyoyrE/edit",
          "mode": "url"
        },
        "sheetName": {
          "__rl": true,
          "value": "TelegramLog",
          "mode": "name"
        },
        "toDelete": "rows",
        "startIndex": 2,
        "numberToDelete": "={{ $('Tin các ngày trước').first().json.prefix }}"
      }
    }
