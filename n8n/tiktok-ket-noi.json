      "parameters": {
        "jsCode": "const r = $input.first().json;\nif (!r.refresh_token) {\n  throw new Error('TikTok không trả token: ' + (r.error_description || r.error || JSON.stringify(r)) +\n    '. Mã chỉ dùng được 1 lần và hết hạn sau vài phút: lấy mã mới rồi chạy lại.');\n}\nreturn [{ json: { key: 'tiktok', refresh_token: r.refresh_token, open_id: r.open_id, scope: r.scope } }];"
      }
