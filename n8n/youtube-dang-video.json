    {
      "id": "697441b5-84b4-54a2-a6b6-9638e00ad008",
      "name": "Chuẩn bị nội dung",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        1540,
        300
      ],
      "parameters": {
        "jsCode": "// YouTube từ chối tiêu đề, mô tả có dấu < >, tiêu đề quá 100 ký tự, mô tả quá 5000 byte và thẻ tổng quá 500 ký tự.\nconst r = $('Lấy 1 video').first().json;\nconst clean = (s) => String(s ?? '').replace(/[<>]/g, '').trim();\nconst cut = (s, n) => (s.length <= n ? s : `${s.slice(0, n - 1).trimEnd()}…`);\nconst title = cut(clean(r.post_title) || clean(r.title) || 'Video', 100);\n// Hashtag của truyện ở cuối mô tả; YouTube hiện ba cái đầu phía trên tiêu đề.\nconst description = cut([clean(r.post_description), clean(r.hashtags)].filter(Boolean).join('\\n\\n'), 4500);\nconst tags = [];\nlet room = 450;\nfor (const t of String(r.tags ?? '').split(',').map((x) => clean(x).replace(/\"/g, '')).filter(Boolean)) {\n  // Thẻ có khoảng trắng bị YouTube tính thêm hai dấu ngoặc kép, mỗi thẻ thêm một dấu phẩy.\n  const cost = t.length + (t.includes(' ') ? 2 : 0) + 1;\n  if (tags.includes(t) || cost > room) continue;\n  tags.push(t);\n  room -= cost;\n}\nreturn [{ json: { title, description, tags: tags.join(',') } }];"
      }
    },
