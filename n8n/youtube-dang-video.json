    {
      "id": "fdcd9264-afd1-58b1-b5d8-9568268baabb",
      "name": "Soạn tin đã đăng",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        3080,
        300
      ],
      "parameters": {
        "jsCode": "const cfg = $('Cấu hình YouTube').first().json;\n// Chưa điền bot Telegram thì bỏ qua bước nhắn tin.\nif (!cfg.telegram_bot_token || cfg.telegram_bot_token.startsWith('DAN_')) return [];\nconst r = $('Lấy 1 video').first().json;\nconst esc = (s) => String(s ?? '').replace(/&/g, '&amp;').replace(/</g, '&lt;').replace(/>/g, '&gt;');\n\nconst p = $('Chuẩn bị nội dung').first().json;\nconst id = $('Đăng YouTube').first().json.id;\nconst sec = Math.round(Number(r.duration_sec) || 0);\nconst pad = (n) => String(n).padStart(2, '0');\nconst length = sec >= 3600 ? `${Math.floor(sec / 3600)}:${pad(Math.floor(sec / 60) % 60)}:${pad(sec % 60)}` : `${Math.floor(sec / 60)}:${pad(sec % 60)}`;\n// Đi qua nhánh ảnh bìa thì kết quả của nó nằm ở đây; lỗi có trường error.\nconst last = $input.first().json;\nconst why = String(last.error?.message ?? last.error ?? '');\nconst cover = !r.cover_file_id ? null\n  : !last.error ? '🖼 Đã đặt ảnh bìa'\n  : `⚠️ Chưa đặt được ảnh bìa: ${esc(why.slice(0, 300))}` +\n    (/forbidden|permission|403/i.test(why) ? '\\nKênh cần xác minh số điện thoại tại youtube.com/verify mới được đặt ảnh bìa riêng.' : '');\nconst text = [\n  '✅ <b>Đã đăng YouTube</b>',\n  `🎬 ${esc(p.title)}`,\n  `⏱ ${length}`,\n  `🔗 https://youtu.be/${id}`,\n  cover,\n].filter(Boolean).join('\\n');\nreturn [{ json: { payload: { chat_id: cfg.telegram_chat_id, parse_mode: 'HTML', text } } }];"
      }
    },
