      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        2420,
        560
      ],
      "parameters": {
        "jsCode": "const cfg = $('Cấu hình YouTube').first().json;\n// Chưa điền bot Telegram thì bỏ qua bước nhắn tin.\nif (!cfg.telegram_bot_token || cfg.telegram_bot_token.startsWith('DAN_')) return [];\nconst r = $('Lấy 1 video').first().json;\nconst esc = (s) => String(s ?? '').replace(/&/g, '&amp;').replace(/</g, '&lt;').replace(/>/g, '&gt;');\n\nconst msg = String($input.first().json.note ?? '').slice(0, 1000);\nconst text = [\n  '❌ <b>Không đăng được video lên YouTube</b>',\n  `🎬 ${esc(r.post_title || r.title)}`,\n  '',\n  `<pre>${esc(msg || 'Lỗi không rõ, xem cột note trong Sheet')}</pre>`,\n  'Sửa xong thì đổi status trong Sheet về pending để đăng lại.',\n].join('\\n');\nreturn [{ json: { payload: { chat_id: cfg.telegram_chat_id, parse_mode: 'HTML', text } } }];"
      },
      "executeOnce": true
    },
