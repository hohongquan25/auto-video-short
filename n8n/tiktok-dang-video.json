      ],
      "parameters": {
        "jsCode": "const cfg = $('Cấu hình TikTok').first().json;\n// Chưa điền bot Telegram thì bỏ qua bước nhắn tin.\nif (!cfg.telegram_bot_token || cfg.telegram_bot_token.startsWith('DAN_')) return [];\nconst r = $('Lấy 1 video').first().json;\nconst esc = (s) => String(s ?? '').replace(/&/g, '&amp;').replace(/</g, '&lt;').replace(/>/g, '&gt;');\nconst part = r.part ? ` · Phần ${r.part}/${r.total_parts}` : ' · Trọn bộ';\nconst s = $('Đánh giá').last().json;\nconst caption = String(r.post_description ?? '').trim();\nconst lines = caption.split('\\n');\nconst isTags = (l) => l.trim() && l.trim().split(/\\s+/).every((w) => w.startsWith('#'));\n// Dòng đầu của caption là tên video, các dòng toàn hashtag là phần hashtag.\nconst name = (lines[0] ?? '').trim() || `${r.title}${part}`;\nconst body = lines.slice(1).filter((l) => !isTags(l)).join('\\n').trim();\nconst tags = String(r.hashtags ?? '').trim() || lines.filter(isTags).join(' ');\nconst block = (label, text) => text ? [`${label} (chạm để copy):`, `<pre>${esc(text.slice(0, 1500))}</pre>`, ''] : [];\nconst sec = Math.round(Number(r.duration_sec) || 0);\nconst text = [\n  `🎬 <b>${esc(r.title)}</b>${part}`,\n  s.status === 'SEND_TO_USER_INBOX'\n    ? '✅ Đã vào hộp thư TikTok, mở app để đăng'\n    : `⏳ TikTok vẫn đang xử lý (${esc(s.status)}), vài phút nữa video sẽ vào hộp thư`,\n  `⏱ ${Math.floor(sec / 60)}:${String(sec % 60).padStart(2, '0')}`,\n  '',\n  ...block('📌 <b>Tên</b>', name),\n  ...block('📝 <b>Nội dung</b>', body),\n  ...block('#️⃣ <b>Hashtag</b>', tags),\n  ...block('📋 <b>Caption đầy đủ</b>, gồm cả 3 phần trên', caption),\n].join('\\n').trim();\nreturn [{ json: { payload: {\n  chat_id: cfg.telegram_chat_id, parse_mode: 'HTML', text, link_preview_options: { is_disabled: true },\n  reply_markup: { inline_keyboard: [[\n    { text: '✅ Đã đăng', callback_data: `posted|${r.id}` },\n    { text: '⏭ Bỏ qua', callback_data: `skip|${r.id}` },\n  ], [\n    { text: '⏩ Đã đăng, gửi tiếp', callback_data: `postnext|${r.id}` },\n  ]] },\n} } }];"
      }
    },
    {
      "id": "bb9c9163-c0d1-4a69-801d-c2b3af34d72f",
      "name": "Soạn tin báo lỗi",
      "type": "n8n-nodes-base.code",
