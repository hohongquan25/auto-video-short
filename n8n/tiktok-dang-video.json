    {
      "id": "3255584b-4708-46dc-8595-4c5c4cdbeeaa",
      "name": "Chọn video",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        660,
        300
      ],
      "parameters": {
        "jsCode": "// Đăng mọi video chưa đăng, kể cả video ngày trước chưa kịp đăng: truyện cũ trước, trong mỗi truyện theo thứ tự phần, bỏ video trọn bộ.\n// Còn video gửi hôm nay nằm trong hộp thư chưa đăng thì chờ; quá 3 giờ thì nhắc đúng 1 lần.\n// Video gửi vào hộp thư từ ngày trước (tin Telegram đã bị dọn lúc 0h) không chặn nữa.\n// Bấm ⏩ trong Telegram thì chạy ngay, không đợi lịch; không gửi được thì nhắn lý do.\nconst force = $('Gửi tiếp từ Telegram').isExecuted;\nconst rows = $input.all().map((i) => i.json);\nconst today = $now.toISODate();\nconst dayOf = (v) => DateTime.fromISO(String(v ?? '')).setZone('Asia/Ho_Chi_Minh').toISODate();\nconst mine = rows.filter((r) => r.format === 'tiktok' || r.format === 'original');\nconst order = (a, b) => String(a.job_id).localeCompare(String(b.job_id)) || Number(a.part || 0) - Number(b.part || 0);\nconst due = (r) => !r.scheduled_at || DateTime.fromISO(String(r.scheduled_at)) <= $now;\nconst label = (r) => `${r.title}${r.part ? ` · Phần ${r.part}/${r.total_parts}` : ''}`;\nconst info = (text) => (force ? [{ json: { mode: 'info', text } }] : []);\n// Video đang gửi dở (khoá chưa quá 30 phút) thì không gửi chồng.\nconst sending = mine.find((r) => r.status === 'posting' && $now.diff(DateTime.fromISO(String(r.posted_at ?? '')), 'minutes').minutes < 30);\nif (sending) return info(`⏳ Đang gửi ${label(sending)} vào TikTok, vài phút nữa sẽ có tin báo.`);\nconst pending = mine.filter((r) => r.status === 'pending' && r.kind !== 'full').sort(order);\nconst next = pending.find(due) ?? null;\nconst waiting = mine.filter((r) => r.status === 'inbox' && dayOf(r.posted_at) === today).sort(order);\nif (waiting.length) {\n  const w = waiting[0];\n  if (force) return info(`📥 ${label(w)} vẫn nằm trong hộp thư TikTok. Đăng xong bấm \"⏩ Đã đăng, gửi tiếp\" để nhận video kế tiếp.`);\n  const sent = DateTime.fromISO(String(w.posted_at ?? ''));\n  const late = !sent.isValid || $now.diff(sent, 'hours').hours >= 3;\n  if (!late || String(w.note ?? '').includes('Đã nhắc')) return [];\n  return [{ json: { mode: 'remind', waiting: w, waitingCount: waiting.length, row: next } }];\n}\nif (next) return [{ json: { mode: 'send', row: next } }];\nconst later = pending[0];\nreturn info(later\n  ? `🕒 Video tiếp theo (${label(later)}) hẹn gửi lúc ${DateTime.fromISO(String(later.scheduled_at)).setZone('Asia/Ho_Chi_Minh').toFormat('HH:mm dd/MM')}.`\n  : '📭 Hết video để gửi.');"
      }
    },
