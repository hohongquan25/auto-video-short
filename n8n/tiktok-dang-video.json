    },
    {
      "id": "46dbc232-8867-4915-9306-96fd4151b6c4",
      "name": "Đánh giá",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        4400,
        200
      ],
      "parameters": {
        "jsCode": "// TikTok cần thêm thời gian xử lý video lớn: kiểm tra lại tối đa 10 lần, cách nhau 30 giây.\nconst d = $input.first().json.data ?? {};\nif (d.status === 'FAILED') throw new Error('TikTok báo lỗi: ' + (d.fail_reason || 'không rõ'));\nconst processing = String(d.status ?? '').startsWith('PROCESSING');\nreturn [{ json: { status: d.status ?? 'không rõ', publish_id: $('Chia khúc').first().json.publish_id, done: !processing || $runIndex >= 9 } }];"
      },
      "onError": "continueErrorOutput"
    },
