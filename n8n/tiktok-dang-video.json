    {
      "id": "372ca5b8-5a47-4277-aacd-69970e5df237",
      "name": "Kiểm tra token",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        2200,
        300
      ],
      "parameters": {
        "jsCode": "const r = $input.first().json;\nif (!r.access_token) {\n  throw new Error('Không làm mới được token TikTok: ' + (r.error_description || r.error || JSON.stringify(r)) +\n    '. Chạy lại workflow \"TikTok - Kết nối\".');\n}\nreturn [{ json: { access_token: r.access_token, refresh_token: r.refresh_token } }];"
      },
      "onError": "continueErrorOutput"
    },
