    {
      "id": "b6af573f-6cb0-451c-9f38-89c71bd0c71e",
      "name": "Kích thước video",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        2640,
        300
      ],
      "parameters": {
        "method": "GET",
        "url": "=https://www.googleapis.com/drive/v3/files/{{ $('Lấy 1 video').first().json.video_file_id }}?fields=size",
        "authentication": "predefinedCredentialType",
        "nodeCredentialType": "googleDriveOAuth2Api",
        "options": {}
      },
      "onError": "continueErrorOutput"
    },
    {
      "id": "c2882f24-6dda-4b46-b304-6a12996687b5",
      "name": "Tính số khúc",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        2860,
        300
      ],
      "parameters": {
        "jsCode": "// TikTok nhận video theo khúc 5–64 MB, khúc cuối gánh phần dư (tối đa 128 MB).\nconst CHUNK = 10 * 1024 * 1024;\nconst size = Number($input.first().json.size);\nif (!size) throw new Error('Không đọc được kích thước video trên Drive');\nconst count = Math.max(1, Math.floor(size / CHUNK));\nreturn [{ json: { video_size: size, chunk_size: count === 1 ? size : CHUNK, total_chunk_count: count } }];"
      },
      "onError": "continueErrorOutput"
    },
    {
      "id": "88d4c36d-1e8a-47ff-839d-ae5b615b6cf9",
      "name": "Khởi tạo upload",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        3080,
        300
      ],
      "parameters": {
        "method": "POST",
        "url": "https://open.tiktokapis.com/v2/post/publish/inbox/video/init/",
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            {
              "name": "Authorization",
              "value": "=Bearer {{ $('Kiểm tra token').first().json.access_token }}"
            }
          ]
        },
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={{ JSON.stringify({ source_info: { source: 'FILE_UPLOAD', video_size: $json.video_size, chunk_size: $json.chunk_size, total_chunk_count: $json.total_chunk_count } }) }}",
        "options": {}
      },
      "onError": "continueErrorOutput"
    },
    {
      "id": "2a476aa5-75a1-4938-9d95-5a663c63955a",
      "name": "Chia khúc",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        3300,
        300
      ],
      "parameters": {
        "jsCode": "const init = $input.first().json;\nconst { upload_url, publish_id } = init.data ?? {};\nif (!upload_url) throw new Error('TikTok không trả upload_url: ' + JSON.stringify(init.error ?? init));\nconst { video_size: size, chunk_size: chunk, total_chunk_count: count } = $('Tính số khúc').first().json;\nconst fileId = $('Lấy 1 video').first().json.video_file_id;\nreturn Array.from({ length: count }, (_, i) => {\n  const start = i * chunk;\n  const end = (i === count - 1 ? size : start + chunk) - 1;\n  return { json: { fileId, upload_url, publish_id, part: i + 1, bytes: `bytes=${start}-${end}`, range: `bytes ${start}-${end}/${size}` } };\n});"
      },
      "onError": "continueErrorOutput"
    },
    {
      "id": "30b3f9f8-c5c1-477a-9f91-5eaacb786ad9",
      "name": "Từng khúc",
      "type": "n8n-nodes-base.splitInBatches",
      "typeVersion": 3,
      "position": [
        3520,
        300
      ],
      "parameters": {
        "batchSize": 1,
        "options": {}
      }
    },
