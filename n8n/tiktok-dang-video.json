    {
      "id": "14090fdb-7ac8-4446-9473-46953e951c98",
      "name": "Soạn tin nhắc",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        1540,
        120
      ],
      "parameters": {
        "jsCode": "const cfg = $('Cấu hình TikTok').first().json;\n// Chưa điền bot Telegram thì bỏ qua bước nhắn tin.\nif (!cfg.telegram_bot_token || cfg.telegram_bot_token.startsWith('DAN_')) return [];\nconst { waiting: w, waitingCount, row } = $('Chọn video').first().json;\nconst esc = (s) => String(s ?? '').replace(/&/g, '&amp;').replace(/</g, '&lt;').replace(/>/g, '&gt;');\nconst label = (r) => `${esc(r.title)}${r.part ? ` · Phần ${r.part}/${r.total_parts}` : ''}`;\nconst sent = DateTime.fromISO(String(w.posted_at ?? ''));\nconst text = [\n  '⏰ <b>Nhắc đăng</b>: video này nằm trong hộp thư TikTok hơn 3 giờ rồi',\n  `🎬 ${label(w)}${sent.isValid ? ` (gửi lúc ${sent.setZone('Asia/Ho_Chi_Minh').toFormat('HH:mm')})` : ''}`,\n  waitingCount > 1 ? `Còn ${waitingCount} video trong hộp thư chưa đăng.` : null,\n  row ? `\\nĐang chờ gửi tiếp: ${label(row)}` : null,\n  '\\nĐăng xong thì bấm ✅ Đã đăng (ở đây hoặc ở tin trước). Bấm ⏩ để nhận video kế tiếp ngay.',\n].filter((l) => l !== null).join('\\n');\nreturn [{ json: { payload: {\n  chat_id: cfg.telegram_chat_id, parse_mode: 'HTML', text,\n  reply_markup: { inline_keyboard: [[\n    { text: '✅ Đã đăng', callback_data: `posted|${w.id}` },\n    { text: '⏭ Bỏ qua', callback_data: `skip|${w.id}` },\n  ], [\n    { text: '⏩ Đã đăng, gửi tiếp', callback_data: `postnext|${w.id}` },\n  ]] },\n} } }];"
      }
    },
