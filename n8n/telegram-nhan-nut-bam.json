    {
      "id": "9576c811-e0b0-4c99-b4bd-ff9a4459f82f",
      "name": "Tách nút bấm",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        880,
        300
      ],
      "parameters": {
        "jsCode": "// ✅ / ⏭ ghi trạng thái vào Sheet. ⏩ gọi ngay workflow \"TikTok - Gửi video vào hộp thư\" thay vì đợi lịch mỗi giờ.\n// Nhánh \"Lọc gửi tiếp\" nằm thấp hơn \"Nút của video?\" trên canvas nên chạy sau khi Sheet đã ghi xong.\nconst cfg = $('Cấu hình Telegram').first().json;\nconst res = $('Hỏi Telegram').first().json;\nif (!res.ok) throw new Error('Telegram: ' + JSON.stringify(res));\nconst at = $now.toFormat('HH:mm dd/MM');\nlet nextTaken = false;\nreturn (res.result ?? [])\n  .map((u) => u.callback_query)\n  // Chỉ nhận nút bấm trong cuộc trò chuyện của bạn.\n  .filter((q) => q && String(q.message?.chat?.id) === String(cfg.chat_id))\n  .map((q) => {\n    const [action, id] = String(q.data ?? '').split('|');\n    const keyboard = q.message.reply_markup?.inline_keyboard ?? [];\n    const base = { action, id, callback_id: q.id, chat_id: q.message.chat.id, message_id: q.message.message_id };\n    // Bấm nhiều lần trong cùng một phút chỉ gửi 1 video.\n    const next = (action === 'next' || action === 'postnext') && !nextTaken;\n    if (next) nextTaken = true;\n    if (action === 'next') {\n      const rows = keyboard.filter((row) => !row.some((btn) => btn.callback_data === 'next'));\n      return { json: { ...base, valid: true, sheet: false, next, answer: 'Đang gửi video tiếp theo, chờ 1–5 phút',\n        markup: { inline_keyboard: [...rows, [{ text: '⏩ Đã gửi tiếp lúc ' + at, callback_data: 'done' }]] } } };\n    }\n    if (!id || !['posted', 'skip', 'postnext'].includes(action)) return { json: { ...base, valid: false } };\n    const posted = action !== 'skip';\n    const label = (posted ? '✅ Đã đăng lúc ' : '⏭ Đã bỏ qua lúc ') + at;\n    // Chỉ tin của workflow TikTok (có nút ⏩) mới giữ nút gửi tiếp sau khi bấm.\n    const canNext = keyboard.flat().some((btn) => String(btn.callback_data ?? '').startsWith('postnext|'));\n    const rows = action === 'postnext'\n      ? [[{ text: label + ', đang gửi tiếp', callback_data: 'done' }]]\n      : [[{ text: label, callback_data: 'done' }], ...(canNext ? [[{ text: '⏩ Gửi video tiếp ngay', callback_data: 'next' }]] : [])];\n    return { json: { ...base, valid: true, sheet: true, next,\n      status: posted ? 'posted' : 'skipped', posted_at: posted ? $now.toISO() : '',\n      answer: action === 'postnext' ? 'Đã ghi: đã đăng. Đang gửi video tiếp theo…' : posted ? 'Đã ghi: đã đăng' : 'Đã ghi: bỏ qua',\n      markup: { inline_keyboard: rows } } };\n  });"
      }
    },
