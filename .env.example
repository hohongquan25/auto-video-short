# Copy file này thành .env.local và điền giá trị thật. .env.local không được commit.

# ── Server ──────────────────────────────────────────────────────────────────
PORT=5178
# 127.0.0.1 = chỉ máy này truy cập được. Đặt 0.0.0.0 để n8n trong Docker (hoặc máy khác)
# gọi được — khi đó bắt buộc đặt API_TOKEN.
HOST=127.0.0.1
# Khoá cho các request không đến từ máy này: gửi header "Authorization: Bearer <API_TOKEN>".
# Tạo chuỗi ngẫu nhiên, ví dụ: node -e "console.log(require('crypto').randomBytes(24).toString('hex'))"
API_TOKEN=
# Địa chỉ để công cụ khác (n8n) truy cập server, dùng cho link video trong webhook/API.
# n8n trong Docker Desktop: http://host.docker.internal:5178
PUBLIC_URL=
# Webhook mặc định được gọi khi job xong / lỗi / chờ duyệt (vd: Webhook node của n8n).
# Có thể đặt riêng cho từng job bằng trường callbackUrl khi tạo job.
WEBHOOK_URL=
# Thư mục chứa job, video nền, preset phong cách
DATA_DIR=./data

# ── Gemini (viết lại kịch bản) ──────────────────────────────────────────────
# Lấy key miễn phí: https://aistudio.google.com/apikey
GEMINI_API_KEY=
# "gemini-flash-latest" luôn trỏ tới bản Flash mới nhất
GEMINI_MODEL=gemini-flash-latest

# ── Whisper local (chuyển giọng nói thành chữ) ──────────────────────────────
# tiny | base | small | medium | large-v3-turbo | large-v3  (lớn hơn = chính xác hơn nhưng chậm hơn)
# large-v3-turbo: nhanh ngang medium trên CPU mà nhận dạng tiếng Việt chính xác hơn
WHISPER_MODEL=large-v3-turbo
WHISPER_LANGUAGE=vi
# Tốc độ nhận dạng (để trống = mặc định đã đo là nhanh nhất trên CPU):
# BATCH_SIZE: số đoạn xử lý cùng lúc (mặc định 8; 1 = tuần tự, chậm hơn nhiều)
# BEAM_SIZE: 1 = nhanh nhất; 5 = chậm hơn ~3 lần, chính xác hơn rất ít
# THREADS: số luồng CPU (0 = tự chọn)
WHISPER_BATCH_SIZE=
WHISPER_BEAM_SIZE=
WHISPER_THREADS=
# Để trống = tự dùng .venv/Scripts/python.exe (tạo bằng `pnpm setup:whisper`)
WHISPER_PYTHON=

# ── FFmpeg (để trống nếu ffmpeg/ffprobe đã có trong PATH) ───────────────────
FFMPEG_PATH=
FFPROBE_PATH=

# ── Claude (viết lại kịch bản bằng gói Claude của bạn qua Claude Code) ──────
# Cài: npm i -g @anthropic-ai/claude-code, rồi chạy `claude` một lần để đăng nhập.
# Lượt dùng tính vào hạn mức gói Claude (Pro/Max/Team), không cần API key.
# Để trống = tự tìm claude.exe trong thư mục npm global hoặc ~/.local/bin
CLAUDE_PATH=
# sonnet | opus | haiku (hoặc tên model đầy đủ)
CLAUDE_MODEL=sonnet

# ── OlvRoc (25 giọng tiếng Việt miễn phí, chạy hoàn toàn trên máy, không cần mạng) ──
# Thư viện: `pnpm setup:whisper` (dùng chung Python với Whisper).
# Model: `pnpm setup:olvroc`, tải một lần vào thư mục models/ (không đưa lên git).
# fp32 = chất lượng tốt nhất (mặc định). int8 = nhanh hơn ~1.6 lần, cần CPU hỗ trợ VNNI
# (CPU đời cũ có thể ra tiếng méo); cần tải thêm bằng `pnpm setup:olvroc --int8`.
OLVROC_PRECISION=

# ── Tải audio từ link video (yt-dlp, cài bằng `pnpm setup:whisper`) ────────
# Nhiều trang (đặc biệt YouTube) yêu cầu đăng nhập. Chọn MỘT trong hai cách:
# 1) File cookies.txt (định dạng Netscape), xuất bằng tiện ích trình duyệt "Get cookies.txt LOCALLY".
#    Nên dùng một tài khoản phụ, vì tài khoản dùng để tải tự động có thể bị đánh dấu.
YTDLP_COOKIES=
# 2) Đọc cookie trực tiếp từ trình duyệt: firefox | chrome | edge | brave…
#    (Chrome/Edge trên Windows thường không đọc được khi trình duyệt đang mở; Firefox ổn định hơn.)
YTDLP_COOKIES_FROM_BROWSER=
# Để trống = dùng yt-dlp trong .venv
YTDLP_PATH=
# Proxy cho yt-dlp: http://host:port, socks5://user:pass@host:port… Để trống = không dùng.
YTDLP_PROXY=
# Giới hạn tốc độ tải (byte/giây), ví dụ 2M hoặc 500K. Để trống = không giới hạn.
YTDLP_LIMIT_RATE=
# 1 = tải bằng aria2c (nhiều kết nối). Cần cài aria2c và có trong PATH.
YTDLP_ARIA2=

# ── Google Drive + Google Sheet (tự lưu video khi xong, để n8n lấy và đăng) ──
# Bỏ trống cả mục này = không tải lên. Hướng dẫn chi tiết: docs/n8n.md, mục 4.
# Chọn MỘT trong hai cách đăng nhập:
# 1) Tài khoản Google của bạn (Gmail thường cũng được): tạo OAuth client loại "Desktop app",
#    điền 2 dòng dưới, khởi động lại server rồi bấm "Kết nối Google" ở mục Hệ thống.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# 2) Service account (file khoá JSON). Chỉ tải lên được thư mục trong Shared Drive (Google Workspace),
#    và phải điền cả GOOGLE_DRIVE_FOLDER_ID lẫn GOOGLE_SHEET_ID.
GOOGLE_SERVICE_ACCOUNT_FILE=
# Thư mục Drive chứa video và bảng tính ghi thông tin: dán id hoặc cả link.
# Cách 1 để trống thì tự tạo thư mục "Story Studio" và bảng tính "Story Studio - Video".
GOOGLE_DRIVE_FOLDER_ID=
GOOGLE_SHEET_ID=
# Tên trang tính (tab) để ghi, tự tạo nếu chưa có
GOOGLE_SHEET_TAB=Videos
