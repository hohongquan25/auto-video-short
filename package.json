{
  "name": "story-studio",
  "version": "0.1.0",
  "private": true,
  "description": "Biến video/audio truyện thành nhiều video ngắn 2–5 phút: Whisper → Gemini viết lại → Edge TTS → ghép video nền",
  "type": "module",
  "scripts": {
    "dev": "concurrently -n server,client -c blue,green \"pnpm:dev:server\" \"pnpm:dev:client\"",
    "dev:server": "tsx watch server/index.ts",
    "dev:client": "vite",
    "build": "vite build",
    "start": "vite build && tsx server/index.ts",
    "setup:whisper": "node scripts/setup-whisper.mjs",
    "setup:olvroc": "node scripts/setup-olvroc.mjs",
    "update:ytdlp": "node scripts/setup-whisper.mjs --ytdlp-only",
    "test": "vitest run",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@google/genai": "^2.28.0",
    "dotenv": "^17.4.2",
    "edge-tts-universal": "^1.4.0",
    "express": "^5.3.0",
    "multer": "^2.4.0",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@types/express": "^5.0.6",
    "@types/multer": "^2.3.0",
    "@types/node": "^25.6.0",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "concurrently": "^10.0.6",
    "lucide-react": "^1.54.0",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "react-router-dom": "^7.18.4",
    "tsx": "^4.23.15",
    "typescript": "^6.0.3",
    "vite": "^8.3.4",
    "vitest": "^5.0.3"
  }
}
